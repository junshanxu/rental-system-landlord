# Node.js 24+. Copy to .env only when overriding local defaults.
HOST=127.0.0.1
PORT=4317
# PUBLIC_ORIGIN=https://your-own-host.example
# COOKIE_SECURE=1
# DATA_DIR=.data
# First startup only. If omitted, a random password is written to .data/local-login.txt.
# BOOTSTRAP_USERNAME=landlord
# BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
# SESSION_HOURS=8

# Optional OpenAI-compatible vision Chat Completions endpoint; server-side only.
# VISION_CHAT_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
# VISION_API_KEY=
# VISION_MODEL=YOUR_ENABLED_VISION_MODEL

# Optional Aholo reconstruction. No paid task is created at startup.
# AHOLO_API_KEY=
# AHOLO_API_BASE=https://api.aholo3d.cn
